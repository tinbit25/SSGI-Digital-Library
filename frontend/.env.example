# SSGI Digital Library — Frontend Environment Variables
# Copy this file to .env and fill in your values before running the dev server or building.

# ─── API Configuration ──────────────────────────────────────────────────
# Base URL for the Laravel backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api

# ─── Production Override ─────────────────────────────────────────────────
# Uncomment and set this when deploying to production:
# VITE_API_BASE_URL=https://api.ssgi.gov.et/api

# ─── App Metadata ────────────────────────────────────────────────────────
VITE_APP_NAME="SSGI Digital Library Portal"
VITE_APP_VERSION=1.0.0
